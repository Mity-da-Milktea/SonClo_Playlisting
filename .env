# Discord bot token. Discord Developer Portalで取得して貼り替えてください。
DISCORD_TOKEN=replace_with_discord_bot_token

# Discord botのClient ID。招待URL作成や管理画面表示に使います。
DISCORD_CLIENT_ID=replace_with_discord_client_id

# SoundCloud APIのClient ID。リンク情報の取得に使います。
SOUNDCLOUD_CLIENT_ID=replace_with_soundcloud_client_id

# SoundCloud OAuthアクセストークン。プレイリストをSoundCloudへ反映する場合に使います。
SOUNDCLOUD_OAUTH_TOKEN=replace_with_soundcloud_oauth_token

# 管理画面のポート番号。
DASHBOARD_PORT=3000

# 収集データの保存先。通常は変更不要です。
DATA_FILE=./data/playlists.json
